rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == 'COLE_AQUI_O_SEU_UID';
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /poems/{poemId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['poemId', 'stars', 'name', 'text', 'createdAt'])
        && request.resource.data.poemId is string
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 600
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
